rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "admin";
    }

    function ehDono(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read: if ehDono(uid) || ehAdmin();
      allow create: if estaAutenticado() && request.auth.uid == uid;
      allow update: if ehDono(uid) || ehAdmin();
      allow delete: if ehAdmin();
    }

    match /cotacoes/{cotacaoId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado() &&
        request.resource.data.criadoPor == request.auth.uid;
      allow update: if estaAutenticado() &&
        (resource.data.criadoPor == request.auth.uid || ehAdmin());
